# ─────────────────────────────────────────────────────────────────────────────
# BTC Paper Trading Bot — environment variables (copy to .env)
# Safe defaults: paper trading on real Binance prices, no API keys.
# main.py copies this file to .env automatically if .env does not exist.
# ─────────────────────────────────────────────────────────────────────────────

# ── Mode ─────────────────────────────────────────────────────────────────────
# true = simulated orders at real Binance prices. Keep true.
PAPER_TRADING=true
# Only used if API keys are set and PAPER_TRADING=false. Keep true.
USE_TESTNET=true
INITIAL_CAPITAL=10000

# ── API keys (leave EMPTY for paper trading) ─────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional: only improves the wording of trade-journal reflections.
# The learning engine never uses it.
ANTHROPIC_API_KEY=

# ── Market data ──────────────────────────────────────────────────────────────
# Public REST base URL. If https://api.binance.com returns HTTP 451 in your
# region use Binance's official public-data mirror:
#   BINANCE_PUBLIC_BASE=https://data-api.binance.vision
# There is NO simulated-data fallback: without Binance access the bot exits.
BINANCE_PUBLIC_BASE=https://api.binance.com

# ── Strategy activation ──────────────────────────────────────────────────────
# A strategy trades only if its 500-day backtest reaches CAGR >= 30%,
# win rate >= 38%, profit factor >= 1.2 AND at least MIN_BACKTEST_TRADES trades
# (below that the profit factor is reported as "n/a").
MIN_BACKTEST_TRADES=30
# If NO strategy passes, the bot runs in OBSERVATION mode (signals + theoretical
# equity in the 'observe' book, no positions). true = trade them all anyway.
ALLOW_UNVALIDATED_STRATEGIES=false

# ── Safe self-learning (adaptive_tuner.py) ───────────────────────────────────
LEARNING_ENABLED=true
# Run a learning cycle every N hours, if there are enough new trades or days.
LEARNING_INTERVAL_HOURS=24
LEARNING_MIN_NEW_TRADES=3
LEARNING_MIN_NEW_DAYS=1
# Walk-forward windows: propose on the older window, validate on the newer one.
LEARNING_PROPOSAL_DAYS=180
LEARNING_VALIDATION_DAYS=180
LEARNING_WARMUP_DAYS=300
# Accept a change only if, on the validation window: >= N trades, profit factor
# at least X better (0.05 = +5%) and > 1, max drawdown at most Y worse (0.02 = +2 pts).
LEARNING_MIN_VALIDATION_TRADES=10
LEARNING_MIN_PF_IMPROVEMENT=0.05
LEARNING_MAX_DD_WORSENING=0.02
LEARNING_MAX_CHANGES_PER_DAY=1
# Roll a change back if, after this many hours, the learning strategy lags its
# frozen baseline copy by more than this fraction of its equity.
LEARNING_ROLLBACK_WINDOW_HOURS=72
LEARNING_ROLLBACK_TOLERANCE_PCT=0.02

# ── Housekeeping ─────────────────────────────────────────────────────────────
# Folder for trading_bot.db (+ -wal/-shm) and trading_bot.log. Empty = the
# project folder. docker-compose.yml sets DATA_DIR=/app/data (mounted ./data).
DATA_DIR=
LOG_LEVEL=INFO
# true = wipe trades/positions/balances/journal on startup (destructive!)
RESET_ON_STARTUP=false
# true = include backtest trades in dashboard views
SHOW_BACKTEST_DATA=false
