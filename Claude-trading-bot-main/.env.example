# ─────────────────────────────────────────────────────────────────────────────
# BTC Paper Trading Bot — environment variables (copy to .env)
# Safe defaults: paper trading on real Binance prices, no API keys.
# main.py copies this file to .env automatically if .env does not exist.
# ─────────────────────────────────────────────────────────────────────────────

# ── Mode ─────────────────────────────────────────────────────────────────────
# true = simulated orders at real Binance prices. Keep true.
PAPER_TRADING=true
# Only used if API keys are set and PAPER_TRADING=false. Keep true.
USE_TESTNET=true
# Cryptocurrencies to trade (Binance spot pairs, comma separated). BTCUSDT is
# the primary one and always included; every other symbol runs its own copy of
# every strategy ('EMA5_Momentum@ETH'), rated, tuned and traded on its own
# candles. The risk budget is shared by all of them.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
# Paper account size ("funds").
INITIAL_CAPITAL=10000

# ── Risk engine (also editable from the dashboard tab "Control") ─────────────
# Most the bot may use; empty = 10% of INITIAL_CAPITAL (e.g. 100 of 1000).
RISK_BUDGET=
# 1 = prudent (only VIABLE strategies, tiny risk) .. 10 = aggressive (also
# strategies still in testing, bigger positions and loss limits).
RISK_AGGRESSIVENESS=5
# trade | close_only (no new entries; open positions run to SL/TP)
RISK_MODE=trade
# Paper shorts. Real spot trading cannot short: set false for spot realism.
RISK_ALLOW_SHORT=true

# ── API keys (leave EMPTY for paper trading) ─────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional: only improves the wording of trade-journal reflections.
# The learning engine never uses it.
ANTHROPIC_API_KEY=

# ── Market data ──────────────────────────────────────────────────────────────
# Public REST base URL. If https://api.binance.com returns HTTP 451 in your
# region use Binance's official public-data mirror:
#   BINANCE_PUBLIC_BASE=https://data-api.binance.vision
# There is NO simulated-data fallback: without Binance access the bot exits.
BINANCE_PUBLIC_BASE=https://api.binance.com

# ── Free market data (market_data.py) — no API key ───────────────────────────
# Binance USD-M futures public data (top-trader / all-account long-short ratios,
# taker volume, open interest, funding) and the Fear & Greed index. If
# fapi.binance.com is blocked in your region the ratio strategies simply HOLD.
BINANCE_FUTURES_BASE=https://fapi.binance.com
FEAR_GREED_URL=https://api.alternative.me/fng/
# Collect every N minutes (the ratio series only exist for the last 30 days, so
# history accumulates from the first run). Funding back-fill on the first run:
MARKET_DATA_INTERVAL_MIN=60
MARKET_FUNDING_BACKFILL_DAYS=1600
# Top traders beyond Binance (public, no key):
#  - OKX top traders' long/short ratios (~60 days of history)
#  - Hyperliquid: on-chain positions of the month's most profitable wallets
#    (account >= HL_MIN_ACCOUNT_USD, profitable all-time and this month, not a
#    market maker: monthly volume <= HL_MAX_TURNOVER x account). The wallet list
#    (a ~40 MB leaderboard) is refreshed every HL_WALLET_REFRESH_HOURS.
#  - CFTC Commitments of Traders: CME Bitcoin / Ether futures, weekly since 2018
OKX_BASE=https://www.okx.com
HL_INFO_URL=https://api.hyperliquid.xyz/info
HL_LEADERBOARD_URL=https://stats-data.hyperliquid.xyz/Mainnet/leaderboard
HL_TOP_WALLETS=150
HL_MIN_ACCOUNT_USD=100000
HL_MAX_TURNOVER=300
HL_WALLET_REFRESH_HOURS=24
CFTC_URL=https://publicreporting.cftc.gov/resource/gpe5-46if.json
# Confirmation engine: before the learning book trades, independent checks vote
# (daily / 4h trend, volatility, market breadth, crowd euphoria / panic, top
# traders, headline tone, severe headlines, US macro calendar, stablecoin
# liquidity, Claude's scheduled review). Needed net votes: aggressiveness 1-3: 2,
# 4-7: 1, 8-10: 0; severe headlines, macro events and Claude can veto.
CONFIRMATIONS_ENABLED=true

# ── Strategy activation ──────────────────────────────────────────────────────
# A strategy trades only if its 500-day backtest reaches CAGR >= 30%,
# win rate >= 38%, profit factor >= 1.2 AND at least MIN_BACKTEST_TRADES trades
# (below that the profit factor is reported as "n/a").
MIN_BACKTEST_TRADES=30
# If NO strategy passes, the bot runs in OBSERVATION mode (signals + theoretical
# equity in the 'observe' book, no positions). true = trade them all anyway.
ALLOW_UNVALIDATED_STRATEGIES=false

# ── Safe self-learning (adaptive_tuner.py) ───────────────────────────────────
LEARNING_ENABLED=true
# Run a learning cycle every N hours, if there are enough new trades or days.
LEARNING_INTERVAL_HOURS=24
LEARNING_MIN_NEW_TRADES=3
LEARNING_MIN_NEW_DAYS=1
# Walk-forward windows: propose on the older window, validate on the newer one.
LEARNING_PROPOSAL_DAYS=180
LEARNING_VALIDATION_DAYS=180
LEARNING_WARMUP_DAYS=300
# Accept a change only if, on the validation window: >= N trades, profit factor
# at least X better (0.05 = +5%) and > 1, max drawdown at most Y worse (0.02 = +2 pts).
LEARNING_MIN_VALIDATION_TRADES=10
LEARNING_MIN_PF_IMPROVEMENT=0.05
LEARNING_MAX_DD_WORSENING=0.02
LEARNING_MAX_CHANGES_PER_DAY=1
# Roll a change back if, after this many hours, the learning strategy lags its
# frozen baseline copy by more than this fraction of its equity.
LEARNING_ROLLBACK_WINDOW_HOURS=72
LEARNING_ROLLBACK_TOLERANCE_PCT=0.02

# ── Strategy evaluator (strategy_evaluator.py) ───────────────────────────────
# Rates every strategy (registered + candidate catalog) on EVAL_WINDOWS walk-
# forward windows, by market regime and by side, plus its live 'lab' trades.
EVAL_ENABLED=true
EVAL_INTERVAL_HOURS=24
EVAL_WINDOWS=4
EVAL_WINDOW_DAYS=180
EVAL_WARMUP_DAYS=300
# VIABLE (trades in any regime): >= trades, PF, profitable windows, max drawdown
VIABLE_MIN_TRADES=30
VIABLE_MIN_PF=1.2
VIABLE_MIN_WINDOWS=3
VIABLE_MAX_DRAWDOWN=0.15
# CONDICIONAL (trades only in the regimes where it works): per-regime minimums
COND_MIN_REGIME_TRADES=10
COND_MIN_REGIME_PF=1.3
# DESCARTADA (value 0, never re-evaluated nor traded): strong evidence only
DISCARD_MIN_TRADES=40
DISCARD_MAX_PF=0.9
DISCARD_MAX_WINDOWS=1
# Mixed results with this many trades and PF < 1 (and no market type where it works) = no edge: discarded
EVAL_NO_EDGE_MIN_TRADES=60
DISCARD_LIVE_MIN_TRADES=20
DISCARD_LIVE_MAX_PF=0.7

# ML confidence (recent win rate, shrunk toward 0.55) only counts trades closed
# in the last N days, so a losing-streak pause expires. Below 0.40 entries pause.
CONFIDENCE_LOOKBACK_DAYS=30

# ── Housekeeping ─────────────────────────────────────────────────────────────
# Folder for trading_bot.db (+ -wal/-shm) and trading_bot.log. Empty = the
# project folder. docker-compose.yml sets DATA_DIR=/app/data (mounted ./data).
DATA_DIR=
LOG_LEVEL=INFO
# true = wipe trades/positions/balances/journal on startup (destructive!)
RESET_ON_STARTUP=false
# true = include backtest trades in dashboard views
SHOW_BACKTEST_DATA=false
